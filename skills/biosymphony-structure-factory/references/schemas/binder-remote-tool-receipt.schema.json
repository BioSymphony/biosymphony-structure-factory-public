{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biosymphony.org/schemas/binder-remote-tool-receipt.schema.json",
  "title": "Provider-neutral binder remote tool receipt",
  "$comment": "This schema describes a sanitized closeout envelope. A valid receipt still requires runtime identity joins, artifact verification, and cleanup checks before a stage can close.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "provider_id",
    "tool_id",
    "operation",
    "request_id",
    "source_identity",
    "model_identity",
    "environment_identity",
    "status",
    "artifacts",
    "cleanup"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract_id": {"const": "structure-factory-remote-tool.v1"},
    "provider_id": {
      "enum": ["api", "aws", "cloud_vm", "fal", "lambda", "local", "modal", "neocloud", "runpod", "ssh_hpc"]
    },
    "tool_id": {"$ref": "#/$defs/tool_id"},
    "operation": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "request_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
    "source_identity": {"type": "string", "pattern": "\\S"},
    "model_identity": {"type": "string", "pattern": "\\S"},
    "environment_identity": {"type": "string", "pattern": "\\S"},
    "status": {"enum": ["completed", "failed", "partial"]},
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    },
    "artifact_count": {"type": "integer", "minimum": 0},
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_spend_usd", "reported_spend_usd"],
      "properties": {
        "max_spend_usd": {"type": "number", "exclusiveMinimum": 0},
        "reported_spend_usd": {"type": "number", "minimum": 0}
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified"],
      "properties": {"verified": {"const": true}}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "completed"}}, "required": ["status"]},
      "then": {"properties": {"artifacts": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "tool_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_count"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_artifact_path"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byte_count": {"type": "integer", "minimum": 1}
      }
    },
    "relative_artifact_path": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*\\u0000)[^/].*$"
    }
  }
}
