{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biosymphony.org/schemas/binder-controller-request.schema.json",
  "title": "Binder local controller request",
  "$comment": "A prepare-execution command derives this request from an exact plan, target verification report, adapter registry, and stage settings. A tool card or provider profile alone cannot satisfy this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "controller_id",
    "plan_sha256",
    "target_verification_sha256",
    "result_boundary",
    "target_verification",
    "workflow_strategy",
    "round_context",
    "budget",
    "stages"
  ],
  "properties": {
    "schema_version": {"const": "structure-factory-binder-controller-v1"},
    "controller_id": {"$ref": "#/$defs/id"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "target_verification_sha256": {"$ref": "#/$defs/sha256"},
    "result_boundary": {
      "enum": ["planning", "public_demo", "public_synthetic_demo", "computational_candidate"]
    },
    "target_verification": {"$ref": "#/$defs/target_verification"},
    "workflow_strategy": {"$ref": "#/$defs/workflow_strategy"},
    "round_context": {"$ref": "#/$defs/round_context"},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "spend_ceiling_usd"],
      "properties": {
        "currency": {"const": "USD"},
        "spend_ceiling_usd": {"type": "number", "minimum": 0}
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/stage"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "schema_version",
        "plan_sha256",
        "target_contract_sha256",
        "target_contract",
        "format",
        "structure_sha256",
        "chain_id",
        "coordinate_residue_count",
        "first_coordinate_residue",
        "last_coordinate_residue",
        "required_residue_count",
        "required_residues_verified",
        "sequence_basis",
        "sequence_length",
        "sequence_sha256",
        "sequence_verified",
        "provider_calls"
      ],
      "properties": {
        "ok": {"const": true},
        "schema_version": {"const": "structure-factory-target-verification-v2"},
        "plan_sha256": {"$ref": "#/$defs/sha256"},
        "target_contract_sha256": {"$ref": "#/$defs/sha256"},
        "target_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_posture", "label", "public_accession", "window", "site"],
          "properties": {
            "input_posture": {"enum": ["public_reference", "synthetic"]},
            "label": {"type": "string", "minLength": 1},
            "public_accession": {
              "type": "string",
              "pattern": "^(?:PDB:[A-Za-z0-9]{4}|UniProt:[A-Z0-9]{6,10}|AlphaFoldDB:[A-Za-z0-9_-]{6,}|SYNTHETIC:[A-Za-z0-9._-]+)$"
            },
            "window": {"type": "string", "minLength": 1},
            "site": {
              "type": "object",
              "additionalProperties": false,
              "required": ["chain_id", "required_residues"],
              "properties": {
                "chain_id": {"type": "string", "pattern": "^[A-Za-z0-9]+$"},
                "required_residues": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "string", "pattern": "^-?[0-9]+(?:[A-Z]|--?[0-9]+)?$"}
                }
              }
            }
          }
        },
        "format": {"enum": ["pdb", "mmcif"]},
        "structure_sha256": {"$ref": "#/$defs/sha256"},
        "chain_id": {"type": "string", "pattern": "^[A-Za-z0-9]+$"},
        "coordinate_residue_count": {"type": "integer", "minimum": 1},
        "first_coordinate_residue": {"type": "string", "pattern": "^-?[0-9]+[A-Z]?$"},
        "last_coordinate_residue": {"type": "string", "pattern": "^-?[0-9]+[A-Z]?$"},
        "required_residue_count": {"type": "integer", "minimum": 1},
        "required_residues_verified": {"const": true},
        "sequence_basis": {"enum": ["coordinates", "entity"]},
        "sequence_length": {"type": "integer", "minimum": 1},
        "sequence_sha256": {"$ref": "#/$defs/sha256"},
        "sequence_verified": {"type": "boolean"},
        "provider_calls": {"const": 0}
      }
    },
    "workflow_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "reference_scope", "replay_toolchain_ids", "swap_toolchain_ids"],
      "properties": {
        "mode": {"enum": ["published_shape_replay", "deliberate_tool_swap", "replay_and_swap", "independent"]},
        "reference_scope": {
          "enum": ["published_tool_identities", "published_workflow_shape", null]
        },
        "replay_toolchain_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "swap_toolchain_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}
      }
    },
    "round_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_round_index",
        "maximum_round_count",
        "primary_metric_id",
        "direction",
        "selected_stages"
      ],
      "properties": {
        "current_round_index": {"type": "integer", "minimum": 1},
        "maximum_round_count": {"type": "integer", "minimum": 1},
        "primary_metric_id": {"$ref": "#/$defs/id"},
        "direction": {"enum": ["maximize", "minimize"]},
        "selected_stages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["generation", "sequence_design", "cofold", "scoring", "filter", "report"]
          }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "backend", "execution_method"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "backend": {
          "enum": ["local", "api", "fal", "neocloud", "runpod", "aws", "modal", "lambda", "cloud_vm", "ssh_hpc"]
        },
        "execution_method": {"enum": ["platform_skill", "hosted_api", "self_hosted"]}
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id",
        "toolchain_id",
        "stage",
        "tool_id",
        "variant_id",
        "route",
        "adapter_id",
        "depends_on",
        "bindings",
        "estimated_cost_usd",
        "timeout_seconds"
      ],
      "properties": {
        "stage_id": {"$ref": "#/$defs/id"},
        "toolchain_id": {"$ref": "#/$defs/id"},
        "stage": {"enum": ["generation", "sequence_design", "cofold", "scoring", "filter"]},
        "tool_id": {"$ref": "#/$defs/id"},
        "variant_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "route": {"$ref": "#/$defs/route"},
        "adapter_id": {"$ref": "#/$defs/id"},
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "bindings": {"type": "object"},
        "input_handoffs": {
          "type": "array",
          "items": {"$ref": "#/$defs/input_handoff"}
        },
        "estimated_cost_usd": {"type": "number", "minimum": 0},
        "timeout_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "input_handoff": {
      "$comment": "The controller derives the artifact kind from the exact source adapter output contract. One matched file or one matched directory bundle is supported.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source_stage_id", "source_output_id", "destination_binding"],
      "properties": {
        "source_stage_id": {"$ref": "#/$defs/id"},
        "source_output_id": {"$ref": "#/$defs/id"},
        "destination_binding": {"$ref": "#/$defs/id"}
      }
    }
  }
}
