{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biosymphony.org/schemas/binder-execution-adapters.schema.json",
  "title": "BioSymphony binder execution adapter registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "boundary", "adapters"],
  "properties": {
    "schema_version": {
      "const": "structure-factory-binder-execution-adapters-v1"
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution", "readiness", "extensions"],
      "properties": {
        "execution": {"type": "string", "minLength": 1},
        "readiness": {"type": "string", "minLength": 1},
        "extensions": {
          "type": "array",
          "minItems": 5,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/adapter"}
    }
  },
  "$defs": {
    "argv": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "placeholder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["string", "integer", "number", "boolean", "path"]},
        "required": {"type": "boolean"},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "choices": {"type": "array", "minItems": 1, "uniqueItems": true}
      }
    },
    "expected_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path_template", "minimum_count"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$"},
        "kind": {"enum": ["directory", "fasta", "json", "jsonl", "pdb", "cif"]},
        "path_template": {"type": "string", "minLength": 1},
        "minimum_count": {"type": "integer", "minimum": 1}
      }
    },
    "supported_route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "execution_method"],
      "properties": {
        "backend": {"enum": ["local", "api", "fal", "neocloud", "runpod", "aws", "modal", "lambda", "cloud_vm", "ssh_hpc"]},
        "execution_method": {"enum": ["platform_skill", "hosted_api", "self_hosted"]}
      }
    },
    "supported_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_id", "variant_id"],
      "properties": {
        "tool_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[a-z0-9.-]*[a-z0-9])?$"},
        "variant_id": {"type": ["string", "null"], "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$"}
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tool_id",
        "supported_selections",
        "roles",
        "supported_routes",
        "license_gate",
        "execution_kind",
        "program",
        "readiness_argv",
        "command_argv",
        "placeholders",
        "required_environment_names",
        "network_policy",
        "expected_outputs",
        "implementation_status",
        "public_evidence"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$"},
        "tool_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[a-z0-9.-]*[a-z0-9])?$"},
        "supported_selections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/supported_selection"}
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["generator", "sequence_designer", "predictor", "scorer", "filter"]}
        },
        "supported_routes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/supported_route"}
        },
        "license_gate": {"type": "string", "pattern": "^[a-z0-9]+(?:[a-z0-9_]*[a-z0-9])?$"},
        "execution_kind": {"enum": ["local_argv", "built_in", "external_adapter"]},
        "program": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"},
        "readiness_argv": {"$ref": "#/$defs/argv"},
        "command_argv": {"$ref": "#/$defs/argv"},
        "placeholders": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
          "additionalProperties": {"$ref": "#/$defs/placeholder"}
        },
        "required_environment_names": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
        },
        "network_policy": {"enum": ["forbidden", "runtime_review_required"]},
        "expected_outputs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/expected_output"}
        },
        "implementation_status": {"enum": ["ready", "built_in", "adapter_required"]},
        "public_evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"implementation_status": {"const": "ready"}}, "required": ["implementation_status"]},
          "then": {
            "properties": {
              "execution_kind": {"const": "local_argv"},
              "program": {"type": "string"},
              "readiness_argv": {"minItems": 1},
              "command_argv": {"minItems": 1}
            }
          }
        },
        {
          "if": {"properties": {"implementation_status": {"const": "built_in"}}, "required": ["implementation_status"]},
          "then": {
            "properties": {
              "execution_kind": {"const": "built_in"},
              "program": {"const": null},
              "readiness_argv": {"maxItems": 0},
              "command_argv": {"maxItems": 0},
              "required_environment_names": {"maxItems": 0},
              "network_policy": {"const": "forbidden"}
            }
          }
        },
        {
          "if": {"properties": {"implementation_status": {"const": "adapter_required"}}, "required": ["implementation_status"]},
          "then": {
            "properties": {
              "execution_kind": {"const": "external_adapter"},
              "program": {"const": null},
              "readiness_argv": {"maxItems": 0},
              "command_argv": {"maxItems": 0}
            }
          }
        }
      ]
    }
  }
}
