{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biosymphony.org/schemas/binder-controller-receipt.schema.json",
  "title": "Binder local controller receipt",
  "$comment": "The receipt records controller and adapter outcomes. It excludes argument values, environment values, provider identifiers, and absolute paths.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "controller_id",
    "plan_sha256",
    "target_verification_sha256",
    "target_structure_sha256",
    "result_boundary",
    "dry_run",
    "authorized",
    "network_authorized",
    "license_gates_authorized",
    "status",
    "planned_stage_count",
    "completed_stage_count",
    "spend_ceiling_usd",
    "estimated_cost_usd",
    "actual_spend_usd",
    "stages",
    "provider_calls"
  ],
  "properties": {
    "schema_version": {"const": "structure-factory-binder-controller-receipt-v1"},
    "controller_id": {"$ref": "#/$defs/id"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "target_verification_sha256": {"$ref": "#/$defs/sha256"},
    "target_structure_sha256": {"$ref": "#/$defs/sha256"},
    "result_boundary": {
      "enum": ["planning", "public_demo", "public_synthetic_demo", "computational_candidate"]
    },
    "dry_run": {"type": "boolean"},
    "authorized": {"type": "boolean"},
    "network_authorized": {"type": "boolean"},
    "license_gates_authorized": {"type": "boolean"},
    "status": {"enum": ["planned", "planned_with_readiness_gaps", "completed", "failed"]},
    "planned_stage_count": {"type": "integer", "minimum": 1},
    "completed_stage_count": {"type": "integer", "minimum": 0},
    "spend_ceiling_usd": {"type": "number", "minimum": 0},
    "estimated_cost_usd": {"type": "number", "minimum": 0},
    "actual_spend_usd": {"type": ["number", "null"], "minimum": 0},
    "stages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stage"}},
    "provider_calls": {"const": 0}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stage": {
      "type": "object",
      "required": ["stage_id", "adapter_id", "state"],
      "properties": {
        "stage_id": {"$ref": "#/$defs/id"},
        "adapter_id": {"$ref": "#/$defs/id"},
        "implementation_status": {"type": "string", "minLength": 1},
        "state": {"enum": ["planned", "not_started", "blocked", "completed", "failed"]},
        "estimated_cost_usd": {"type": "number", "minimum": 0},
        "receipt_path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "output_contract_count": {"type": "integer", "minimum": 0},
        "input_handoffs": {
          "type": "array",
          "items": {"$ref": "#/$defs/input_handoff"}
        },
        "failure": {"type": "object"}
      },
      "additionalProperties": false
    },
    "input_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_stage_id",
        "source_output_id",
        "destination_binding",
        "artifact_kind",
        "state",
        "source_receipt_sha256",
        "source_artifact_sha256",
        "destination_artifact_sha256",
        "file_count",
        "byte_count",
        "record_count"
      ],
      "properties": {
        "source_stage_id": {"$ref": "#/$defs/id"},
        "source_output_id": {"$ref": "#/$defs/id"},
        "destination_binding": {"$ref": "#/$defs/id"},
        "artifact_kind": {
          "enum": ["file", "directory", "json", "jsonl", "fasta", "pdb", "cif"]
        },
        "state": {"enum": ["planned", "materialized"]},
        "source_receipt_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "source_artifact_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "destination_artifact_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "file_count": {"type": ["integer", "null"], "minimum": 1},
        "byte_count": {"type": ["integer", "null"], "minimum": 0},
        "record_count": {"type": ["integer", "null"], "minimum": 1}
      }
    }
  }
}
